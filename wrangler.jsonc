{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "telegram-selfie-page",
  "main": "worker.mjs",
  "compatibility_date": "2025-03-01",
  "assets": {
    "directory": "./app/static",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "telegram-selfie-links",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "PUBLIC_BASE_URL": "https://SET-YOUR-WORKERS-DEV-URL"
  },
  "observability": {
    "enabled": true
  }
}
